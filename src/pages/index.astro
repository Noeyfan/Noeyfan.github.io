---
import BaseLayout from '../layouts/BaseLayout.astro';

const images = [
  '/images/Pitt_img.JPG',
  '/images/img_3911.jpg',
  '/images/dsc_9145.jpg',
  '/images/p1.JPG',
  '/images/p3.JPG',
  '/images/Suika.jpg',
];
---

<BaseLayout>
  <section class="home frame">
    <figure class="photo-stage">
      <img id="home-photo" src={images[0]} alt="A photograph from Fan You's archive" width="1200" height="800" />
      <figcaption>
        <span>visual log</span>
        <button id="next-photo" type="button" aria-label="Show next photograph">01 / 06</button>
      </figcaption>
    </figure>

  </section>
</BaseLayout>

<script is:inline define:vars={{ images }}>
  const photo = document.querySelector('#home-photo');
  const button = document.querySelector('#next-photo');
  let index = 0;

  const render = () => {
    if (!(photo instanceof HTMLImageElement) || !(button instanceof HTMLButtonElement)) return;
    photo.src = images[index];
    button.textContent = `${String(index + 1).padStart(2, '0')} / ${String(images.length).padStart(2, '0')}`;
  };

  button?.addEventListener('click', () => {
    index = (index + 1) % images.length;
    render();
  });

  render();
</script>
