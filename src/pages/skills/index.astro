---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { skills, skillGroups } from '../../data/skills';
---

<BaseLayout title="life skill tree" description="A living map of skills Fan You is practicing, exploring and revisiting.">
  <section class="page frame">
    <header class="page-title">
      <span>MAP–01 · living document</span>
      <h1>life skill tree</h1>
      <p>Not a scorecard. A small map of capabilities I’m building, where they come from, and what I want to practice next.</p>
    </header>

    <div class="skill-controls" aria-label="Filter skills">
      <button type="button" data-filter="all" class="is-active">all</button>
      {skillGroups.map((group) => <button type="button" data-filter={group}>{group}</button>)}
    </div>

    <div class="skill-grid">
      {skillGroups.map((group, groupIndex) => (
        <section class="skill-group" data-group={group}>
          <header><span>0{groupIndex + 1}</span><h2>{group}</h2></header>
          {skills.filter((skill) => skill.group === group).map((skill) => (
            <article class="skill" data-skill={skill.id}>
              <div class="skill-top"><h3>{skill.name}</h3><span>{skill.status}</span></div>
              <div class="level" aria-label={`level ${skill.level} of 5`}>
                {[1, 2, 3, 4, 5].map((step) => <i class:list={{ filled: step <= skill.level }}></i>)}
              </div>
              <p>{skill.note}</p>
              {skill.evidence && <small>{skill.evidence}</small>}
            </article>
          ))}
        </section>
      ))}
    </div>
  </section>
</BaseLayout>

<script>
  const controls = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const groups = document.querySelectorAll<HTMLElement>('[data-group]');
  controls.forEach((control) => {
    control.addEventListener('click', () => {
      const filter = control.dataset.filter;
      controls.forEach((item) => item.classList.toggle('is-active', item === control));
      groups.forEach((group) => {
        group.hidden = filter !== 'all' && group.dataset.group !== filter;
      });
    });
  });
</script>
